# Dependencies
node_modules/
.pnp
.pnp.*

# Build output
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# Environment secrets
# A committed workspace key would let anyone who reads the repo decrypt every
# image produced by that build, so these never leave the machine.
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage output
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.stylelintcache
.turbo/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
